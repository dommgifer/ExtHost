<Window x:Class="ExtHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ExtHost.Controls"
        xmlns:b="clr-namespace:ExtHost.Bookmarks"
        xmlns:local="clr-namespace:ExtHost"
        Title="ExtHost"
        Icon="Assets/app.ico"
        Width="1280" Height="820" MinWidth="640" MinHeight="400"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="#BDB9B0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TabStripRowDef" Height="44" />
                <RowDefinition x:Name="ToolbarRowDef" Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="StatusRowDef" Height="26" />
            </Grid.RowDefinitions>

            <!-- ===== 分頁列（同時是標題列） ===== -->
            <Grid Grid.Row="0" Background="{StaticResource TabStripBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,4,10,0">
                    <Image Source="Assets/app.ico" Width="16" Height="16" Margin="0,0,8,0" />
                    <TextBlock Text="ExtHost" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <Border x:Name="DevBadge" Background="{StaticResource DevBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="DEV" FontSize="11" Foreground="White" />
                    </Border>
                </StackPanel>

                <DockPanel Grid.Column="1" LastChildFill="False">
                    <ListBox x:Name="TabList" DockPanel.Dock="Left" Margin="0,0,40,0"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource TabItemStyle}"
                             SelectionChanged="TabList_SelectionChanged"
                             WindowChrome.IsHitTestVisibleInChrome="True">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:TabStripPanel ClipToBounds="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="38" Background="Transparent" ToolTip="{Binding Title}"
                                      MouseDown="TabItem_MouseDown"
                                      PreviewMouseLeftButtonDown="TabItem_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="PageDragSource_PreviewMouseMove">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="16" Height="16" Margin="12,0,8,0">
                                        <Grid x:Name="IconHost">
                                            <Image Source="{Binding Icon}" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}" />
                                        </Grid>
                                        <Ellipse x:Name="Spinner" Width="14" Height="14" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                                 StrokeDashArray="3 2" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2" Content="&#xE8BB;" Style="{StaticResource TabCloseButton}" Margin="4,0,8,0"
                                            Click="CloseTabButton_Click" ToolTip="關閉分頁 (Ctrl+W)" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="IconHost" Property="Visibility" Value="Hidden" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinStory">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Spinner"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinStory" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="NewTabButton" DockPanel.Dock="Left" Margin="-36,6,0,0" Width="32" Height="32"
                            Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="13"
                            Click="NewTab_Click" ToolTip="新增分頁 (Ctrl+T)"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </DockPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="最小化"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="最大化"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="CloseWindow_Click" ToolTip="關閉"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!-- ===== 工具列 ===== -->
            <Border x:Name="ToolbarBorder" Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource IconButton}" Content="&#xE72B;" Click="Back_Click" ToolTip="上一頁 (Alt+←)" />
                    <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE72A;" Click="Forward_Click" ToolTip="下一頁 (Alt+→)" />
                    <Button x:Name="ReloadButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Reload_Click" ToolTip="重新整理 (F5)" />

                    <Border x:Name="AddressBorder" Grid.Column="3" Height="34" Margin="8,0" CornerRadius="17"
                            Background="{StaticResource AddressBrush}" BorderBrush="Transparent" BorderThickness="2">
                        <Grid Margin="12,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SecurityIcon" FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE72E;"
                                       Background="Transparent" Cursor="Hand"
                                       PreviewMouseLeftButtonDown="SecurityIcon_PreviewMouseLeftButtonDown"
                                       PreviewMouseMove="PageDragSource_PreviewMouseMove"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="AddressBox" Grid.Column="1" Style="{StaticResource AddressTextBox}"
                                     KeyDown="AddressBox_KeyDown"
                                     GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                                     LostKeyboardFocus="AddressBox_LostKeyboardFocus"
                                     PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown" />
                            <Border x:Name="InjectChip" Grid.Column="2" CornerRadius="10" Background="{StaticResource AccentSoftBrush}"
                                    Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="InjectChipText" FontSize="12" Foreground="{StaticResource AccentTextBrush}" />
                            </Border>
                            <Button x:Name="StarButton" Grid.Column="3" Style="{StaticResource AddressIconButton}" Margin="4,0,-4,0"
                                    Content="&#xE734;" Click="Star_Click" ToolTip="將這個分頁加入書籤 (Ctrl+D)" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="ExtToolbar" Grid.Column="4" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ExtButton}" Tag="{Binding}" ToolTip="{Binding ToolTip}"
                                        Click="ExtButton_Click" MouseRightButtonUp="ExtButton_RightClick">
                                    <Grid Width="22" Height="22">
                                        <Image Source="{Binding Icon}" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Border CornerRadius="5" Background="{Binding BadgeBrush}"
                                                Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="{Binding BadgeLetter}" Foreground="White" FontSize="12" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="ExtMenuButton" Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xEA86;"
                            Click="ExtMenu_Click" ToolTip="擴充功能" />
                    <Rectangle Grid.Column="6" Width="1" Height="22" Fill="{StaticResource BorderBrush}" Margin="4,0" />
                    <Button x:Name="DevReloadButton" Grid.Column="7" Style="{StaticResource DevButton}" Margin="0,0,4,0"
                            Click="ReloadExtensions_Click" ToolTip="重新載入所有擴充功能 (Ctrl+Shift+R)" Padding="10,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="重載擴充" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="8" Style="{StaticResource IconButton}" Content="&#xEC7A;" Click="DevTools_Click" ToolTip="開發人員工具 (F12)" />
                    <Button x:Name="MainMenuButton" Grid.Column="9" Style="{StaticResource IconButton}" Content="&#xE712;" Click="MainMenu_Click" ToolTip="選單" />
                </Grid>
            </Border>

            <!-- ===== 書籤列 ===== -->
            <b:BookmarkBar x:Name="BookmarkBarControl" Grid.Row="2" Visibility="Collapsed" />

            <!-- ===== 內容 ===== -->
            <Grid x:Name="ContentArea" Grid.Row="3" SizeChanged="ContentArea_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ContentCol" Width="*" MinWidth="240" />
                    <ColumnDefinition x:Name="SidePanelSplitterCol" Width="0" />
                    <ColumnDefinition x:Name="SidePanelCol" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="ContentHost" Background="White" />
                <!-- 擴充功能側邊欄（WebView2 沒有 Side Panel UI，由 ExtHost 代管） -->
                <GridSplitter x:Name="SidePanelSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ShowsPreview="False"
                              Background="{StaticResource BorderBrush}" Visibility="Collapsed"
                              DragCompleted="SidePanelSplitter_DragCompleted" />
                <local:ExtensionSidePanel x:Name="SidePanel" Grid.Column="2" Visibility="Collapsed" />
            </Grid>

            <!-- ===== 狀態列 ===== -->
            <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ExtCountText" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0" />
                        <TextBlock x:Name="ProfileText" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0" />
                        <TextBlock x:Name="HoverText" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextTrimming="CharacterEllipsis" MaxWidth="700" />
                    </StackPanel>
                    <TextBlock x:Name="RuntimeText" Grid.Column="1" FontSize="12" FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
