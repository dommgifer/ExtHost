<UserControl x:Class="ExtHost.Tabs.ExtensionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource TextBrush}"
             AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,28,40,40" MaxWidth="1240">

            <!-- 標題與開關 -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="擴充功能" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" />
                <CheckBox x:Name="WatchToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Content="監看資料夾變更"
                          Margin="0,0,28,0" VerticalAlignment="Center" Click="WatchToggle_Click"
                          ToolTip="擴充功能資料夾有檔案變更時自動重新載入" />
                <CheckBox x:Name="DevToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Content="開發人員模式"
                          Tag="{StaticResource DevBrush}" VerticalAlignment="Center" Click="DevToggle_Click" />
            </Grid>

            <!-- 操作按鈕 -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource PrimaryButton}" Click="LoadUnpacked_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="載入未封裝的擴充功能" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ReloadAllButton" Grid.Column="1" Style="{StaticResource DevButton}" Height="38" Padding="14,0"
                        Margin="10,0,0,0" Click="ReloadAll_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="全部重新載入" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="38" FontSize="14" Padding="14,0"
                        Margin="10,0,0,0" Click="OpenDataFolder_Click" Content="開啟資料資料夾" />
                <Border Grid.Column="4" Height="38" Width="260" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource SubtleBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="14"
                                 VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="搜尋擴充功能" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 說明 -->
            <Border CornerRadius="10" Background="{StaticResource InfoSoftBrush}" BorderBrush="{StaticResource InfoBorderBrush}"
                    BorderThickness="1" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource AccentBrush}"
                               Margin="0,1,12,0" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource InfoTextBrush}" LineHeight="20">
                        WebView2 只提供擴充功能執行環境，沒有瀏覽器 UI。popup 與選項頁由 ExtHost 工具列代為開啟；
                        使用 tabs、contextMenus、sidePanel 等 API 的功能會在下方標示「需實測」。
                        修改擴充功能程式碼後按「重新載入」，開著「監看資料夾變更」時會自動重新載入。
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 空清單 -->
            <TextBlock x:Name="EmptyText" Text="尚未載入任何擴充功能。按「載入未封裝的擴充功能」選擇含 manifest.json 的資料夾，或直接把資料夾拖進這個頁面。"
                       FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,16" />

            <!-- 擴充功能卡片 -->
            <ItemsControl x:Name="Cards">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="18" Margin="0,0,16,16">
                            <DockPanel LastChildFill="False">
                                <!-- 標題列 -->
                                <Grid DockPanel.Dock="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="44" Height="44" VerticalAlignment="Top" Margin="0,0,14,0"
                                          Opacity="{Binding IsDimmed, Converter={StaticResource DimOpacity}}">
                                        <Image Source="{Binding Icon}" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Border CornerRadius="10" Background="{Binding BadgeBrush}"
                                                Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="{Binding BadgeLetter}" Foreground="White" FontSize="20" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Version}" FontSize="12" FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <Border Background="{StaticResource AddressBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                    VerticalAlignment="Center" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top" Margin="12,2,0,0"
                                              IsChecked="{Binding IsEnabled, Mode=OneWay}" Tag="{x:Null}" DataContext="{Binding}"
                                              Click="EnableToggle_Click" ToolTip="啟用 / 停用" />
                                </Grid>

                                <!-- ID 與路徑 -->
                                <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}">
                                        <Run Text="ID  " /><Run Text="{Binding DisplayId, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding DisplayPath}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayPath}" />
                                </StackPanel>

                                <!-- 相容性 -->
                                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Chips}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Chip" CornerRadius="10" Padding="8,2" Margin="0,0,6,6"
                                                    Background="{StaticResource OkSoftBrush}" ToolTip="{Binding Tooltip}">
                                                <TextBlock x:Name="ChipText" Text="{Binding Text}" FontSize="12" Foreground="{StaticResource OkTextBrush}" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource WarnSoftBrush}" />
                                                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource WarnTextBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 錯誤 -->
                                <Border DockPanel.Dock="Top" CornerRadius="8" Background="{StaticResource DangerSoftBrush}" Padding="10,8" Margin="0,6,0,0"
                                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{StaticResource DangerTextBrush}" Margin="0,1,8,0" />
                                        <TextBox Grid.Column="1" Text="{Binding LastError, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                 Background="Transparent" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                 Foreground="{StaticResource DangerTextBrush}" />
                                    </Grid>
                                </Border>

                                <!-- 按鈕 -->
                                <Border DockPanel.Dock="Bottom" BorderBrush="#EFEDE8" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                                    <DockPanel LastChildFill="False">
                                        <Button Style="{StaticResource SecondaryButton}" Content="開啟 popup" Margin="0,0,8,0" Click="Popup_Click"
                                                Visibility="{Binding HasPopup, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="選項" Margin="0,0,8,0" Click="Options_Click"
                                                Visibility="{Binding HasOptions, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="開啟資料夾" Margin="0,0,8,0" Click="Folder_Click"
                                                Visibility="{Binding HasPath, Converter={StaticResource BoolToVis}}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="移除" Click="Remove_Click" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="14"
                                                Content="&#xE72C;" ToolTip="重新載入" Click="Reload_Click"
                                                Visibility="{Binding HasPath, Converter={StaticResource BoolToVis}}" />
                                    </DockPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 拖放區 -->
            <Border x:Name="DropZone" CornerRadius="12" BorderBrush="#C9C5BC" BorderThickness="2" Padding="24" Margin="0,0,16,0"
                    Cursor="Hand" MouseLeftButtonUp="DropZone_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFEDE7" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="把含 manifest.json 的資料夾拖到這裡" FontSize="14" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,2" />
                    <TextBlock Text="載入後會出現在工具列" FontSize="12" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="DataFolderText" FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="0,20,0,0"
                       FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
